# PostgreSQL (локально: docker compose up postgres -d)
DATABASE_URL=postgresql://splitch:splitch@127.0.0.1:5432/splitch

# URL сервиса проверки чека (multipart POST)
CHECK_VERIFY_URL=https://proverka-cheka.online/process.php

# API
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Web (Vite)
# Пусто = относительные /api через proxy. Либо абсолютный URL:
# VITE_API_URL=http://localhost:3000
# Куда проксировать /api и /ws (по умолчанию http://localhost:3000):
# VITE_API_PROXY=http://localhost:3000
# Docker-compose API на хосте: VITE_API_PROXY=http://localhost:3001
