{
  "name": "@splitch/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:push": "drizzle-kit push",
    "test": "vitest run && bun test src/routes/api.integration.test.ts",
    "test:unit": "vitest run",
    "test:integration": "bun test src/routes/api.integration.test.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.2.0",
    "@splitch/calc": "file:../../packages/calc",
    "@splitch/types": "file:../../packages/types",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.39.3",
    "elysia": "^1.2.25",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
